  "fixed_sql": [
    {
      "name": "workouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workouts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "exercise_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"group_name\" TEXT NULL, \"description\" TEXT NULL, \"image_data\" BLOB NULL, \"exercise_type\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "workout_exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"workout_id\" INTEGER NOT NULL REFERENCES workouts (id), \"category_id\" INTEGER NOT NULL REFERENCES exercise_categories (id), \"target_sets\" INTEGER NULL, \"target_reps\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plans\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "plan_workouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plan_workouts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"plan_id\" INTEGER NOT NULL REFERENCES plans (id), \"workout_id\" INTEGER NOT NULL REFERENCES workouts (id), \"date_str\" TEXT NULL, \"weekday\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "workout_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"workout_sets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NOT NULL REFERENCES exercise_categories (id), \"date_str\" TEXT NOT NULL, \"timestamp\" INTEGER NOT NULL, \"weight_kg\" REAL NULL, \"reps\" INTEGER NULL, \"time_secs\" INTEGER NULL, \"rpe\" INTEGER NULL, \"grade\" TEXT NULL, \"wall_angle\" INTEGER NULL, \"climb_name\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "day_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"day_notes\" (\"date_str\" TEXT NOT NULL, \"note\" TEXT NOT NULL, PRIMARY KEY (\"date_str\"));"
        }
      ]
    },
    {
      "name": "body_weights",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"body_weights\" (\"date_str\" TEXT NOT NULL, \"kg\" REAL NOT NULL, PRIMARY KEY (\"date_str\"));"
        }
      ]
    },
    {
      "name": "inspirations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inspirations\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"url\" TEXT NOT NULL, \"notes\" TEXT NULL, \"category_id\" INTEGER NULL REFERENCES exercise_categories (id), \"added_at\" INTEGER NOT NULL);"
        }
      ]
    }
  ]
